# All optional.
# Where `npm run dev` forwards /api to (default: the public status page). Keep real values in .env.local, never here.
VITE_DEV_GATUS_TARGET=
# vex-auth, the sign-in shared by the *.vexoul.net sites (default: the production one, through createAccount()).
# Point it at a local vex-auth for dev; empty turns sign-in off.
VITE_AUTH_BASE=https://auth.example.net
# A build for another Gatus (one on a private network, say) sets these. They are build-time: `npm run build` bakes them in.
# The page's name, in the tab and over the services (default: vexoul.net status).
VITE_STATUS_TITLE=
# `off` puts that name in the header instead of the vexoul.net site switcher.
VITE_STATUS_SWITCHER=
# Gatus groups in page order, comma-separated (default: websites,API,infrastructure). Others follow alphabetically.
VITE_STATUS_GROUPS=
